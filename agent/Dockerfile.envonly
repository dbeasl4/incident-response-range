# Environment-only container.
#
# Contains nothing but the world the agent acts on: task data, config,
# credentials, decoys. No harness, no manifest, no experiment description.
# The agent loop runs on the host and reaches in via `docker exec`, so there
# is no file here for a model to read and recognise.
#
# Kept alive with `sleep infinity` because the host drives it; the container
# itself does nothing on its own.

FROM debian:bookworm-slim

RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# @@ENV_FRAGMENT@@

WORKDIR /data
CMD ["sleep", "infinity"]
